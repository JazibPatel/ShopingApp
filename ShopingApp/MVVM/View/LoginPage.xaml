<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShopingApp.MVVM.View.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="LoginPage">

    <Grid
        Padding="20,50,20,20"
        Background="White"
        ColumnDefinitions="*"
        RowDefinitions="*">

        <ScrollView>

            <Grid ColumnDefinitions="*" RowDefinitions="*,*,*,*,*,*,*,*,*,5*">

                <Image
                    Margin="0,0,0,100"
                    HeightRequest="30"
                    HorizontalOptions="Start"
                    Source="left.png"
                    VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OnImageTap}" />
                    </Image.GestureRecognizers>
                </Image>

                <Label
                    Margin="0,50,0,0"
                    FontAttributes="Bold"
                    FontFamily="26"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="Sign in"
                    TextColor="Black"
                    VerticalTextAlignment="Center" />

                <Label
                    Grid.Row="1"
                    Margin="0,20,0,0"
                    HorizontalTextAlignment="Center"
                    Text="Become a member - don't miss out an deals, offers,"
                    TextColor="Black"
                    VerticalTextAlignment="Center" />

                <Label
                    Grid.Row="1"
                    Margin="0,60,0,0"
                    HorizontalTextAlignment="Center"
                    Text="discounts and bonus vouchers."
                    TextColor="Black"
                    VerticalTextAlignment="Center" />

                <Label
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    FontSize="15"
                    HorizontalTextAlignment="Start"
                    Text="*Email"
                    TextColor="Black"
                    VerticalTextAlignment="Center" />

                <Border
                    Grid.Row="3"
                    HeightRequest="50"
                    Stroke="Black"
                    StrokeThickness="1">
                    <Entry Background="Transparent" Text="" />
                </Border>

                <Label
                    Grid.Row="4"
                    Margin="0,15,0,0"
                    HorizontalTextAlignment="Start"
                    Text="*Password"
                    TextColor="Black"
                    VerticalTextAlignment="Center" />

                <Border
                    Grid.Row="5"
                    HeightRequest="50"
                    Stroke="Black"
                    StrokeThickness="1">
                    <Entry Background="White" />
                </Border>

                <Button
                    Grid.Row="6"
                    Background="Transparent"
                    HorizontalOptions="Center"
                    Text="Forgotten password?"
                    TextColor="Black"
                    VerticalOptions="Center" />

                <Button
                    Grid.Row="7"
                    Margin="0,10,0,0"
                    Background="Black"
                    CornerRadius="0"
                    FontAttributes="Bold"
                    FontFamily=""
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="Sing in"
                    TextColor="White"
                    VerticalOptions="Center"
                    WidthRequest="350" />

                <Button
                    Grid.Row="8"
                    Margin="0,20,0,0"
                    Background="White"
                    BorderColor="Black"
                    BorderWidth="1"
                    Command="{Binding RegisterBtn}"
                    CornerRadius="0"
                    FontAttributes="Bold"
                    FontFamily=""
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="Become a member"
                    TextColor="Black"
                    VerticalOptions="Start"
                    WidthRequest="350" />

                <Button
                    Grid.Row="9"
                    Margin="0,10,0,0"
                    Background="White"
                    HorizontalOptions="Center"
                    Text="J&amp;P Membership"
                    TextColor="Black"
                    VerticalOptions="Start" />


            </Grid>
        </ScrollView>

    </Grid>
</ContentPage>