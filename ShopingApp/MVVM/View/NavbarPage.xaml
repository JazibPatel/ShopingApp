<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShopingApp.MVVM.View.NavbarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="NavbarPage">

    <Grid
        Padding="10,20,10,10"
        BackgroundColor="White"
        ColumnDefinitions="*,2*,*,*,*,*"
        RowDefinitions="*"
        VerticalOptions="Center">

        <Image
            Grid.Column="0"
            HeightRequest="30"
            HorizontalOptions="Start"
            Source="menu.png">
            <!--<Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NavbarTab}" />
            </Image.GestureRecognizers>-->
        </Image>

        <Image
            Grid.Column="2"
            HeightRequest="30"
            HorizontalOptions="Center"
            Source="search.png" />

        <Image
            Grid.Column="3"
            HeightRequest="30"
            HorizontalOptions="Center"
            Source="person.png" />

        <Image
            Grid.Column="4"
            HeightRequest="30"
            HorizontalOptions="Center"
            Source="heart.png" />

        <Image
            Grid.Column="5"
            HeightRequest="25"
            HorizontalOptions="Center"
            Source="bag.png" />

    </Grid>
</ContentPage>