<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShopingApp.MVVM.View.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShopingApp.MVVM.View"
    Title="HomePage">

    <Grid
        Padding="0,0,0,0"
        BackgroundColor="White"
        RowDefinitions="60,*">

        <Grid
            Padding="10,20,10,10"
            BackgroundColor="White"
            ColumnDefinitions="*,2*,*,*,*,*"
            RowDefinitions="*"
            VerticalOptions="Center">

            <ImageButton
                Grid.Column="0"
                Clicked="ImageButton_Clicked"
                HeightRequest="30"
                HorizontalOptions="Start"
                Source="menu.png" />



            <ImageButton
                Grid.Column="2"
                Command="{Binding SearchBtn}"
                HeightRequest="30"
                HorizontalOptions="Center"
                Source="search.png" />

            <ImageButton
                Grid.Column="3"
                Command="{Binding LoginBtn}"
                HeightRequest="30"
                HorizontalOptions="Center"
                Source="person.png" />

            <Image
                Grid.Column="4"
                HeightRequest="30"
                HorizontalOptions="Center"
                Source="heart.png" />

            <Image
                Grid.Column="5"
                HeightRequest="25"
                HorizontalOptions="Center"
                Source="bag.png" />

        </Grid>


        <ScrollView Grid.Row="1">
            <Grid
                Padding="15"
                ColumnDefinitions="*"
                RowDefinitions="*">

                <Grid
                    Margin="0,0,0,50"
                    ColumnDefinitions="*"
                    RowDefinitions="*,*,*,*,*,*,*,*,*,*">

                    <Button
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        Background="#faf9f8"
                        Text="Free shipping above Rs. 1999"
                        TextColor="Black" />

                    <Image
                        Grid.Row="2"
                        Margin="0,50,0,0"
                        Source="hp1.jpg" />
                    <Label
                        Grid.Row="2"
                        Padding="30,0,0,0"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Start"
                        Text="New season"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="2"
                        Margin="0,60,0,0"
                        Padding="30,0,0,0"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Start"
                        Text="denim"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Image
                        Grid.Row="3"
                        Margin="0,50,0,0"
                        Source="hp2.jpg" />

                    <Label
                        Grid.Row="3"
                        Margin="10,150,20,40"
                        Padding="10"
                        Background="Black"
                        FontSize="15"
                        HeightRequest="45"
                        HorizontalOptions="End"
                        Text="Rs. 5,999.00"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="3"
                        Margin="0,0,0,35"
                        Padding="30,0,0,0"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Start"
                        Text="Soft glamour"
                        TextColor="White"
                        VerticalOptions="End" />

                    <Label
                        Grid.Row="3"
                        Margin="0,0,0,5"
                        Padding="30,0,0,0"
                        FontSize="15"
                        HorizontalOptions="Start"
                        Text="A modern tribute to iconic menswar."
                        TextColor="White"
                        VerticalOptions="End" />

                    <Grid
                        Grid.Row="4"
                        Margin="0,50,0,0"
                        ColumnDefinitions="*,30"
                        RowDefinitions="*">


                        <ImageButton
                            Grid.ColumnSpan="2"
                            Aspect="AspectFill"
                            Clicked="HomePageCategory"
                            HeightRequest="100"
                            Source="light2.png" />


                        <Label
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily=""
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            Text="Just in: The latest styles&#10;starting at ₹799"
                            TextColor="Black"
                            VerticalTextAlignment="Center" />

                        <Label
                            Grid.Column="0"
                            Margin="0,70,0,0"
                            BackgroundColor="Transparent"
                            FontFamily=""
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            Text="Explore the collection"
                            TextColor="Black"
                            VerticalTextAlignment="Center" />

                        <Image
                            x:Name="CategoryDropdown"
                            HeightRequest="30"
                            HorizontalOptions="End"
                            Source="plus.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                    </Grid>

                    <Grid
                        x:Name="CategoryDropdownMenu"
                        Grid.Row="5"
                        Padding="0,15,0,15"
                        ColumnDefinitions="*"
                        RowDefinitions="*,*,*,*,*,*">

                        <Button
                            Padding="0,0,300,0"
                            BackgroundColor="White"
                            CornerRadius="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            HorizontalOptions="Fill"
                            Text="Ladies"
                            TextColor="Black"
                            VerticalOptions="Center" />
                        <Image
                            HorizontalOptions="End"
                            Source="right.png"
                            VerticalOptions="Center" />

                    </Grid>



                    <Label
                        Grid.Row="6"
                        Margin="0,50,0,0"
                        FontAttributes="Bold"
                        FontFamily=""
                        FontSize="18"
                        HorizontalTextAlignment="Start"
                        Text="Best of All"
                        TextColor="Black"
                        VerticalTextAlignment="Center" />

                    <CarouselView
                        x:Name="HomeCarouse"
                        Grid.Row="7"
                        Margin="0,20,0,0"
                        HeightRequest="300"
                        ItemsSource="{Binding Product}"
                        PeekAreaInsets="90">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*" RowDefinitions="*,*,*">
                                    <Image
                                        Grid.Row="0"
                                        Aspect="AspectFill"
                                        HeightRequest="300"
                                        HorizontalOptions="Center"
                                        Source="{Binding ImageUrl}"
                                        VerticalOptions="Center"
                                        WidthRequest="150" />

                                    <Label
                                        Grid.Row="1"
                                        Margin="25,90,0,0"
                                        HeightRequest="60"
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding Name}"
                                        TextColor="Black"
                                        VerticalTextAlignment="End" />
                                    <Label
                                        Grid.Row="2"
                                        Margin="25,5,0,0"
                                        HeightRequest="50"
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding Price, StringFormat='Rs. {0:F2}'}"
                                        TextColor="Black"
                                        VerticalTextAlignment="Start" />
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>


                    <Image Grid.Row="8" Source="hp3.png" />

                    <Label
                        Grid.Row="8"
                        Margin="10,100,20,40"
                        Padding="10"
                        Background="Black"
                        FontSize="15"
                        HeightRequest="45"
                        HorizontalOptions="End"
                        Text="Rs. 799.00"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="8"
                        Margin="0,0,0,15"
                        FontAttributes="Bold"
                        FontFamily=""
                        FontSize="20"
                        HorizontalOptions="Center"
                        Text="A fresh start"
                        TextColor="Black"
                        VerticalOptions="End" />

                    <Image
                        Grid.Row="9"
                        Margin="0,50,0,0"
                        Source="hp5.png" />

                    <Label
                        Grid.Row="9"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="The Best of J&amp;P Home from"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <Label
                        Grid.Row="9"
                        Margin="0,60,0,0"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="₹249"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <Label
                        Grid.Row="9"
                        Margin="0,120,0,0"
                        FontSize="15"
                        HorizontalTextAlignment="Center"
                        Text="Browse the collection &amp; elevate your space."
                        TextColor="Black"
                        VerticalTextAlignment="Center" />

                    <Image
                        Grid.Row="10"
                        Margin="0,50,0,0"
                        HorizontalOptions="FillAndExpand"
                        Source="hp4.png" />
                    <Label
                        Grid.Row="10"
                        Padding="30,0,0,0"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Start"
                        Text="New season"
                        TextColor="Black"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="10"
                        Margin="0,60,0,0"
                        Padding="30,0,0,0"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Start"
                        Text="preppy"
                        TextColor="Black"
                        VerticalOptions="Center" />


                </Grid>
            </Grid>
        </ScrollView>

        <ContentView
            x:Name="FlyoutNavbar"
            Margin="0,800,0,0"
            HeightRequest="860"
            HorizontalOptions="Start"
            IsVisible="False"
            VerticalOptions="FillAndExpand">

            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
            </ContentView.GestureRecognizers>

            <Grid
                BackgroundColor="Black"
                ColumnDefinitions="*"
                RowDefinitions="*,*,*"
                WidthRequest="350">
                <Label
                    Grid.Column="0"
                    Text="jdfhjwfjg"
                    TextColor="AliceBlue" />
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="jdfhjwfjg"
                    TextColor="AliceBlue" />
                <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="jdfhjwfjg"
                    TextColor="AliceBlue" />
            </Grid>
        </ContentView>
    </Grid>



</ContentPage>