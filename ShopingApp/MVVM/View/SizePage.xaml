<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShopingApp.MVVM.View.SizePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="SizePage">

    <Grid Background="White" RowDefinitions="100,*">

        <ImageButton
            Margin="20,0,0,0"
            Background="White"
            Clicked="BackBtn"
            CornerRadius="30"
            HeightRequest="40"
            HorizontalOptions="Start"
            Source="left.png"
            VerticalOptions="Center"
            WidthRequest="40" />

        <Image
            Grid.Row="1"
            HorizontalOptions="Center"
            Source="size.png"
            VerticalOptions="Center" />

    </Grid>
</ContentPage>